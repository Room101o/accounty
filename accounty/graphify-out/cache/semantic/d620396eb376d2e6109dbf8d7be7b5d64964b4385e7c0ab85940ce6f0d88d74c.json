{"nodes": [{"id": "auth_token_identifier", "label": "tokenIdentifier Canonical Identity Key", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tokenIdentifier is guaranteed and canonical stable identifier for authenticated identity. Prefer over identity.subject for auth-linked DB lookups and ownership checks."}, {"id": "auth_convex_provider_with_auth", "label": "ConvexProviderWithAuth", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use ConvexProviderWithAuth instead of ConvexProvider when using external auth providers. Must provide useAuth prop returning {isLoading, isAuthenticated, fetchAccessToken}."}, {"id": "convex_guidelines", "label": "Convex AI Guidelines", "file_type": "document", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "guidelines_http_endpoints", "label": "HTTP Endpoints (httpAction)", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTTP endpoints defined in convex/http.ts using httpAction decorator and httpRouter. Registered at exact path specified."}, {"id": "guidelines_validators", "label": "Convex Validators (v.*)", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALWAYS include argument validators for all Convex functions. Validators: v.id, v.null, v.int64, v.number, v.boolean, v.string, v.bytes, v.array, v.object, v.record, v.union, v.literal, v.optional."}, {"id": "guidelines_function_registration", "label": "Function Registration (public vs internal)", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use internalQuery/internalMutation/internalAction for private functions. Use query/mutation/action for public API. Do NOT use query/mutation for sensitive internal functions."}, {"id": "guidelines_pagination", "label": "Pagination (paginationOptsValidator)", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use paginationOptsValidator for paginated queries. Returns {page, isDone, continueCursor}. Never use .collect().length to count rows."}, {"id": "guidelines_schema_rules", "label": "Schema Guidelines", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Define schema in convex/schema.ts. No unbounded arrays in documents. Separate high-churn data (heartbeats, presence) from stable profile data. Always include all index fields in index name."}, {"id": "guidelines_no_filter_use_withindex", "label": "No .filter() - Use withIndex()", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do NOT use filter in queries. Define an index and use withIndex instead. Always return bounded collections (.take() or paginate), never unbounded .collect()."}, {"id": "guidelines_action_node_runtime", "label": "Actions and Node.js Runtime", "file_type": "rationale", "source_file": "convex/_generated/ai/guidelines.md", "source_location": null, "source_url": null, 
{"nodes": [{"id": "perf_occ_conflicts", "label": "OCC Conflict Resolution", "file_type": "document", "source_file": ".claude/skills/convex-performance-audit/references/occ-conflicts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "perf_occ_optimistic_concurrency", "label": "Optimistic Concurrency Control (OCC)", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/occ-conflicts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Convex uses OCC: when two transactions overlap, one retries. High contention causes wasted work and latency spikes. Counter sharding and deferring secondary writes reduces conflicts."}, {"id": "perf_hot_documents", "label": "Hot Document Splitting Pattern", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/occ-conflicts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shard counters across multiple documents to reduce write contention. Aggregate shards in query or scheduled job."}, {"id": "perf_scheduled_secondary_work", "label": "Schedule Secondary Work Pattern", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/occ-conflicts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move analytics, non-critical notifications, and cache warming out of the primary mutation using ctx.scheduler.runAfter to reduce transaction read/write set size"}], "edges": [{"source": "perf_occ_conflicts", "target": "perf_occ_optimistic_concurrency", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/convex-performance-audit/references/occ-conflicts.md", "source_location": null, "weight": 1.0}, {"source": "
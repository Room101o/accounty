{"nodes": [{"id": "perf_hot_path_rules", "label": "Hot Path Rules", "file_type": "document", "source_file": ".claude/skills/convex-performance-audit/references/hot-path-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "perf_push_filters_storage", "label": "Push Filters to Storage (withIndex)", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/hot-path-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only withIndex() and withSearchIndex() reduce docs scanned. JS .filter() and Convex .filter() both scan first. Prefer index-based filtering to minimize reads."}, {"id": "perf_digest_tables", "label": "Digest / Summary Tables Pattern", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/hot-path-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hot list pages should read the smallest document shape. A summary/digest table with subset fields is cheaper than full source docs on hot paths."}, {"id": "perf_isolate_churn_fields", "label": "Isolate Frequently-Updated Fields", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/hot-path-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-churn fields (lastSeen, counters, presence) should be in separate documents to avoid invalidating all subscribers of widely-read documents"}, {"id": "perf_denormalization", "label": "Denormalization for Hot Paths", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/hot-path-rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Denormalize when path is ho
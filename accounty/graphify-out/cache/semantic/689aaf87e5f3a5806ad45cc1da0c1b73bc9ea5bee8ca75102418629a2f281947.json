{"nodes": [{"id": "perf_subscription_cost", "label": "Subscription Cost Rules", "file_type": "document", "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "perf_subscription_reactivity", "label": "Reactive Subscriptions (useQuery)", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every useQuery/usePaginatedQuery creates a live subscription. Server re-executes query when read set changes. Cost = subscriptions x invalidation_frequency x query_cost."}, {"id": "perf_point_in_time_reads", "label": "Point-in-Time Reads Pattern", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For high-read/low-freshness flows use fetchQuery, ConvexHttpClient.query(), or server-rendered fetches instead of reactive subscriptions to avoid ongoing subscription cost"}, {"id": "perf_aggregate_component", "label": "@convex-dev/aggregate Component", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maintains denormalized COUNT, SUM, MAX values efficiently for leaderboards, totals, badges without reactive full-table scans"}, {"id": "perf_date_now_anti_pattern", "label": "Date.now() in Queries Anti-Pattern", "file_type": "rationale", "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using Date.now() inside a query defeats Convex query caching, causing frequent re-evaluation. Use boolean flags updated by scheduled functions instead."}], "edges": [{"source": "perf_subscription_cost", "target": "perf_subscription_reactivity", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "weight": 1.0}, {"source": "perf_subscription_cost", "target": "perf_point_in_time_reads", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "weight": 1.0}, {"source": "perf_subscription_cost", "target": "perf_aggregate_component", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "weight": 1.0}, {"source": "perf_subscription_cost", "target": "perf_date_now_anti_pattern", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "weight": 1.0}, {"source": "perf_isolate_churn_fields", "target": "perf_occ_conflicts", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/convex-performance-audit/references/subscription-cost.md", "source_location": null, "weight": 0.9}], "hyperedges": []}